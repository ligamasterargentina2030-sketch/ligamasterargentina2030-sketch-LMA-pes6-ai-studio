{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server.ts,src/server/**,src/assets/images/**,data/league.json,data/uploads/**,firebase-applet-config.json}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index?__path=/api" },
    { "source": "/api/(.*)", "destination": "/api/index?__path=/api/$1" },
    { "source": "/uploads/(.*)", "destination": "/api/index?__path=/uploads/$1" },
    { "source": "/default-assets/(.*)", "destination": "/api/index?__path=/default-assets/$1" },
    { "source": "/LMA-pes6-ai-studio/api", "destination": "/api/index?__path=/api" },
    { "source": "/LMA-pes6-ai-studio/api/(.*)", "destination": "/api/index?__path=/api/$1" },
    { "source": "/LMA-pes6-ai-studio/uploads/(.*)", "destination": "/api/index?__path=/uploads/$1" },
    { "source": "/LMA-pes6-ai-studio/default-assets/(.*)", "destination": "/api/index?__path=/default-assets/$1" },
    {
      "source": "/((?!assets/|api/|uploads/|default-assets/|manifest\\.json|sw\\.js|workbox-.*|pwa-.*|apple-touch-icon\\.png|favicon\\.ico|static-bootstrap\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
